# Notenverwaltung – was NICHT ins Repository gehört
# Grundsatz: keine echten Schülerdaten, keine Datenbanken, keine Schlüssel, nichts Erzeugtes.

# ---- Datenbanken, Sicherungen, Schlüsseldateien, Notfallblätter
*.nvdb
*.nvdb.*
# Ausnahme: erfundene Testdatenbank für den Kompatibilitätstest Linux ↔ Windows
!tests/daten/kompatibilitaet_linux.nvdb
!tests/daten/version_*.nvdb
*.nvkey
notfallblatt*.pdf
/daten/
/sicherungen/

# ---- Erzeugte Ausgaben
/ausgabe/
*.pdf
!docs/**/*.pdf
# Ausnahme: das Handbuch (Beispieldaten mit erfundenen Namen)
!handbuch/Handbuch.pdf

# ---- Python / Build
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
/build/
/dist/
*.spec.bak
*.egg-info/

# ---- Lokales
.claude/settings.local.json
.env
